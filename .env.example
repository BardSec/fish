# Copy to .env and adjust. All values are optional and have sensible defaults.

# Flask session signing key. CHANGE THIS in production.
SECRET_KEY=change-me-in-production

# Database connection string.
# Default (local dev): a SQLite file in ./instance/fishing_atlas.db
# DATABASE_URL=sqlite:///instance/fishing_atlas.db
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/fishing_atlas

# Where uploaded photos are stored.
# UPLOAD_FOLDER=app/static/uploads
# MAX_CONTENT_LENGTH=16777216

# --- Map (Leaflet + OpenStreetMap) -------------------------------------------
# We use OpenStreetMap, which needs NO API key. These only need changing if you
# want a different tile provider. (If you later switch to Mapbox, this is where
# a token-bearing tile URL would go — keeping the key out of source.)
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Default map center/zoom (East Tennessee — Townsend / Little River).
# MAP_DEFAULT_LAT=35.6754
# MAP_DEFAULT_LNG=-83.7563
# MAP_DEFAULT_ZOOM=11

# Docker: seed sample data on first boot (1 = if empty, force = always, 0 = never).
# AUTO_SEED=1
